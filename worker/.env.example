# ── Worker (FastAPI + Celery) ─────────────────────────────
REDIS_URL=redis://localhost:6379/0
WORKER_PORT=8000

# Supabase (service role: 서버 전용, 절대 프론트에 노출 금지)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=   # sb_secret_... (서버 전용, 절대 프론트 노출 금지)

# Cloudflare R2 (S3 호환)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=adcut-media
R2_PUBLIC_BASE_URL=

# STT: clova | whisper  (처음엔 whisper 로컬로 시작, 상용은 clova)
STT_PROVIDER=whisper
WHISPER_MODEL=small   # CPU 서버는 small, GPU면 large-v3
CLOVA_SPEECH_INVOKE_URL=
CLOVA_SPEECH_SECRET=

# OpenAI API (대본 대조, 트렌드 분석, 의료광고법 검수)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_MODEL_CHEAP=gpt-5.4-mini

# YouTube Data API v3 (트렌드 수집)
YOUTUBE_API_KEY=
